// ShareKeep screens: one column of cards in the Capture style, centred and capped in width on a
// desktop. Bottom tabs: Home, Approvals, Settings (and Hub on the hub computer).

import { LineEdit, Slider, Switch, ScrollView, Palette, AboutSlint } from "std-widgets.slint";
import { Theme, Card, SectionTitle, Hint, FieldLabel, BigButton, LinkButton, Chip, Badge, NavTab, KeyValue, Stat } from "components.slint";

export { Theme }

export struct MemberS { id: int, name: string, balance: string, sign: int }
export struct CardS { id: int, name: string, headline: string, sign: int, members: [MemberS], period: string, waiting: int }
export struct FileS { sha: string, name: string, size: string }
export struct ActivityS { seq: int, date: string, title: string, detail: string, amount: string, disputed: bool, editable: bool, files: [FileS], can-attach: bool }
export struct RuleS { id: int, name: string, method: string, detail: string }
export struct PeriodS { key: string, label: string, state: string, closed: bool, can-close: bool }
export struct ApprovalS { seq: int, title: string, detail: string }
export struct SplitS { name: string, amount: string }
export struct ExampleS { amount: string, rows: [SplitS] }
export struct WeightS { name: string, value: float, included: bool, locked: bool, amount: string, remainder: bool }
export struct ChoiceS { id: int, label: string, on: bool }
export struct DeviceS { id: int, name: string, detail: string, revoked: bool }
export struct DueS { name: string, date: string, detail: string, bill: bool, mine: bool, overdue: bool }
export struct DepositEventS { seq: int, text: string, can-correct: bool }
export struct DepositS { label: string, kind: string, balance: string, detail: string, history: [DepositEventS] }
export struct RecurringS { id: int, name: string, detail: string, stopped: bool }
export struct NeedS { name: string, value: string }
export struct EventS { name: string, detail: string }
export struct ItemS { amount: string, members: [ChoiceS] }
export struct BookS { file: string, name: string, detail: string, encrypted: bool, broken: bool }
export struct BackupS { file: string, title: string, detail: string, ok: bool }

// Vertically scrolling page, centred and capped in width for desktops.
component Page inherits ScrollView {
    content-width: self.visible-width;
    content-height: col.preferred-height + 24px;
    col := VerticalLayout {
        x: max(0px, (root.visible-width - self.width) / 2);
        width: min(root.visible-width, 640px);
        padding: 12px;
        padding-bottom: 24px;
        spacing: 12px;
        @children
    }
}

// Text field with a label above it.
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> number: false;
    in property <bool> secret: false;
    in-out property <string> text;
    callback edited(string);
    spacing: 4px;
    horizontal-stretch: 1;
    FieldLabel { text: root.label; }
    LineEdit {
        min-height: 44px;
        min-width: 56px;
        text <=> root.text;
        placeholder-text: root.placeholder;
        input-type: root.secret ? InputType.password : root.number ? InputType.decimal : InputType.text;
        edited(t) => { root.edited(t); }
    }
}

// Horizontal chip strip that scrolls sideways on narrow screens.
component ChipStrip inherits Flickable {
    in property <[ChoiceS]> chips;
    callback picked(int);
    height: 44px;
    content-width: max(self.width, row.preferred-width);
    interactive: row.preferred-width > self.width;
    row := HorizontalLayout {
        alignment: start;
        spacing: 8px;
        for c in root.chips: Chip {
            text: c.label;
            on: c.on;
            clicked => { root.picked(c.id); }
        }
    }
}

// A bottom sheet over the page.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <color> title-color: Theme.ink;
    callback dismissed;
    background: #0f172a80;
    TouchArea { clicked => { root.dismissed(); } }
    Rectangle {
        y: max(40px, parent.height - self.height);
        height: min(parent.height - 40px, sheet.preferred-height + 8px);
        width: min(parent.width, 640px);
        x: (parent.width - self.width) / 2;
        background: Theme.bg;
        border-top-left-radius: 18px;
        border-top-right-radius: 18px;
        TouchArea { }
        ScrollView {
            content-width: self.visible-width;
            content-height: sheet.preferred-height;
            sheet := VerticalLayout {
                width: parent.visible-width;
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    Text {
                        text: root.title;
                        font-size: 20px;
                        font-weight: 700;
                        color: root.title-color;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    LinkButton { text: "Close"; fg: Theme.muted; clicked => { root.dismissed(); } }
                }
                @children
            }
        }
    }
}

// Money with its sign shown by colour and words (never colour alone).
component Amount inherits Text {
    in property <int> sign;
    font-size: Theme.font-body;
    font-weight: 600;
    color: sign > 0 ? Theme.green : sign < 0 ? Theme.red : Theme.muted;
    horizontal-alignment: right;
}

component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    height: t.preferred-height + 16px;
    border-radius: 10px;
    background: warn ? Theme.amber-soft : Theme.accent-soft;
    border-width: 1px;
    border-color: warn ? Theme.amber-line : Theme.accent;
    t := Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.text;
        wrap: word-wrap;
        font-size: 14px;
        color: warn ? Theme.amber : Theme.accent-dark;
    }
}

// EZ Start: one step on the screen. Its number, what it's for, and only what this step needs.
component EzStep inherits VerticalLayout {
    in property <int> number;
    in property <int> total;
    in property <string> title;
    in property <string> purpose;
    in property <bool> can-back: number > 1;
    callback back();
    spacing: 12px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for i in root.total: Rectangle {
            width: i + 1 == root.number ? 28px : 10px;
            height: 10px;
            border-radius: 5px;
            background: i + 1 <= root.number ? Theme.accent : Theme.line;
        }
    }
    Text {
        text: "Step " + root.number + " of " + root.total;
        font-size: 14px;
        font-weight: 600;
        color: Theme.accent;
    }
    Text {
        text: root.title;
        font-size: 24px;
        font-weight: 700;
        color: Theme.ink;
        wrap: word-wrap;
    }
    Rectangle {
        background: Theme.accent-soft;
        border-radius: 10px;
        height: why.preferred-height + 20px;
        why := Text {
            x: 12px;
            width: parent.width - 24px;
            text: "Why: " + root.purpose;
            font-size: 15px;
            color: Theme.accent-dark;
            wrap: word-wrap;
        }
    }
    Card {
        @children
    }
    if root.can-back: LinkButton { text: "‹ Back to step " + (root.number - 1); fg: Theme.muted; clicked => { root.back(); } }
}

// A new agreement's options: how often it settles up, from when, and how expenses split at
// first. Used by EZ Start (step 4) and the Hub tab.
component AgreementOptions inherits VerticalLayout {
    in-out property <int> how: 2;
    in-out property <string> day: "1";
    in-out property <int> weekday: 4;
    in-out property <string> start;
    in-out property <int> split: 0;
    in property <string> start-hint;
    spacing: 8px;
    FieldLabel { text: "Settle up"; }
    // scrolls sideways on a narrow window, like the other chip rows
    ChipStrip {
        chips: [
            { id: 0, label: "Weekly", on: root.how == 0 },
            { id: 1, label: "Every 2 weeks", on: root.how == 1 },
            { id: 2, label: "Monthly", on: root.how == 2 },
            { id: 3, label: "Every N days", on: root.how == 3 },
        ];
        picked(id) => { root.how = id; }
    }
    if root.how == 2: Field { label: "Day of the month (1–28, or 31 for the last day)"; number: true; text <=> root.day; }
    if root.how == 3: Field { label: "Every how many days (1–365)"; number: true; text <=> root.day; }
    if root.how <= 1: FieldLabel { text: "On"; }
    if root.how <= 1: HorizontalLayout {
        spacing: 4px;
        alignment: LayoutAlignment.start;
        for w[i] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Chip { text: w; on: root.weekday == i; clicked => { root.weekday = i; } }
    }
    Field { label: "First period starts (YYYY-MM-DD)"; placeholder: root.start-hint; text <=> root.start; }
    Hint { text: "Leave it empty to start with the period you're in now (" + root.start-hint + "). A start between settle-up days makes a short first period."; }
    FieldLabel { text: "Split expenses"; }
    HorizontalLayout {
        spacing: 6px;
        alignment: LayoutAlignment.start;
        Chip { text: "Equally"; on: root.split == 0; clicked => { root.split = 0; } }
        Chip { text: "Set it up later"; on: root.split == 1; clicked => { root.split = 1; } }
    }
    Hint { text: root.split == 0 ? "A first rule, everyone the same, is proposed in the name of the first person picked; the others approve it on their devices. Other ways to split (percentages, shares, by income, by room…) are proposed later from the agreement's Rules tab." : "Expenses can't be added until someone proposes a rule from the agreement's Rules tab and everyone approves it."; }
}

component SplitList inherits VerticalLayout {
    in property <[SplitS]> rows;
    spacing: 4px;
    for r in root.rows: KeyValue { label: r.name; value: r.amount; }
}

export component AppWindow inherits Window {
    title: "ShareKeep" + (root.book-name != "" ? " – " + root.book-name : "");
    icon: @image-url("../../../assets/icon.png");
    preferred-width: 430px;
    preferred-height: 860px;
    min-width: 360px;
    min-height: 560px;
    background: Theme.bg;
    default-font-size: 15px;

    // ----- state from Rust -----
    in-out property <int> page: 0;
    in-out property <int> tab: 0;
    in property <string> book-name;
    in property <string> me-name;
    in property <string> banner;
    in property <bool> offline;
    in property <int> pending;
    in property <[string]> refused;
    in property <string> toast;
    in property <bool> is-hub;

    in property <[CardS]> cards;
    in property <string> agreement-name;
    in property <string> agreement-period;
    in property <[ActivityS]> activity;
    in property <[RuleS]> rules;
    in property <[MemberS]> members;
    in property <[string]> settle;
    in property <[PeriodS]> periods;
    in property <[ApprovalS]> approvals;
    in property <[DueS]> due;
    in property <[DepositS]> deposits;
    in property <[RecurringS]> recurring;

    // join a hub
    in-out property <string> hub-address;
    in property <string> hub-fingerprint;
    in-out property <string> connect-code;
    in-out property <string> connect-pin;
    in-out property <string> device-name;
    in-out property <string> connect-checkpoint;
    in property <string> connect-error;
    in property <bool> busy;
    // EZ Start: the step on screen (joining: 1–3; the hub computer: 1–5)
    in-out property <int> join-step: 1;
    // 7: join a hub, or make this computer the hub (0.1.4)
    in property <string> hub-offer-kind;   // "windows", "mac" or "no"
    in property <string> hub-offer-note;   // why "no"
    in property <string> hub-folder-note;  // a hub folder found here that can't be used
    in-out property <int> make-hub-step: 0;  // 0 the choice, 1 what will happen
    in-out property <bool> make-hub-busy;
    in-out property <string> make-hub-error;
    callback make-hub();
    callback check-for-hub();
    in property <int> ez-step: 1;
    in property <int> ez-people;

    // the expense sheet
    in-out property <bool> exp-open;
    in property <string> exp-title: "New expense";
    in property <string> schedule-text;
    in-out property <string> exp-amount;
    in-out property <string> exp-category;
    in-out property <string> exp-date;
    in-out property <string> exp-note;
    in property <[ChoiceS]> exp-payers;
    in property <[SplitS]> exp-preview;
    in property <string> exp-error;
    // a rule by days or usage: one field per person
    in property <string> exp-needs-title;
    in property <[NeedS]> exp-needs;
    in property <bool> exp-itemized;
    in property <[ItemS]> exp-items;

    // the payment sheet
    in-out property <bool> pay-open;
    in-out property <string> pay-amount;
    in property <[ChoiceS]> pay-from;
    in property <[ChoiceS]> pay-to;
    in property <string> pay-error;

    // the rule editor
    in-out property <bool> rule-open;
    in-out property <string> rule-name;
    in-out property <string> rule-categories;
    in property <[ChoiceS]> rule-methods;
    in property <[WeightS]> rule-weights;
    in property <bool> rule-exact;
    in property <string> rule-when;
    in property <string> exp-no-rule;
    callback propose-for-expense();

    // one form sheet for the agreement's other changes (deposits, recurring bills, events,
    // the schedule, joining and leaving): the controller sets which fields it shows
    in-out property <bool> form-open;
    in property <string> form-title;
    in property <string> form-hint;
    in property <string> form-error;
    in property <string> form-save-text: "Save";
    in property <string> form-kinds-label;
    in property <[ChoiceS]> form-kinds;
    in property <string> form-sub-label;
    in property <[ChoiceS]> form-sub;
    in property <string> form-name-label;
    in-out property <string> form-name;
    in property <string> form-name-placeholder;
    in property <string> form-amount-label;
    in-out property <string> form-amount;
    in property <string> form-text-label;
    in-out property <string> form-text;
    in property <string> form-text-placeholder;
    in property <string> form-date-label;
    in-out property <string> form-date;
    in property <string> form-date2-label;
    in-out property <string> form-date2;
    in property <string> form-people-label;
    in property <[ChoiceS]> form-people;
    in property <string> form-people2-label;
    in property <[ChoiceS]> form-people2;
    in property <[EventS]> events;
    in property <bool> can-join;
    in property <bool> rule-percent;
    in property <bool> rule-weighted;
    in property <float> rule-max: 10;
    in property <string> rule-unit;
    in property <string> rule-hint;
    in property <[ExampleS]> rule-examples;
    in property <string> rule-error;

    // Hyperbook, Verify, recovery
    in property <bool> is-hyperbook;
    in property <string> hb-head;
    // Settings > Help and questions (sk_view::help)
    in property <string> help-text;
    in property <string> hb-fingerprint;
    in property <string> hb-seen;
    in property <string> hb-stale;
    in property <string> checkpoint-text;
    in property <image> checkpoint-qr;
    in-out property <string> checkpoint-input;
    in property <string> check-answer;
    in property <bool> check-ok;
    in property <string> verify-answer;
    in property <bool> verify-ok;
    in property <string> restore-text;
    in property <bool> checkpoint-failed;

    // the hub computer
    in-out property <string> hub-pin;
    // closed books (the open one is hub-current-*)
    in property <[BookS]> hub-books;
    in property <string> hub-current-name;
    in property <string> hub-current-detail;
    in property <bool> hub-pin-set;
    in property <int> hub-pick-count;
    in property <[ChoiceS]> hub-members;
    in property <[ChoiceS]> hub-agreement-members;
    in property <[DeviceS]> hub-devices;
    in property <string> hub-code;
    in property <string> hub-code-detail;
    in property <image> hub-qr;
    in property <string> hub-error;
    in property <string> hub-info;
    // recovering a broken book on the hub
    in property <string> rec-file;
    in property <string> rec-name;
    in property <string> rec-problem;
    in property <[BackupS]> rec-backups;
    in property <string> rec-lost;
    in property <string> rec-backup;
    in-out property <string> new-book-name;
    in-out property <bool> new-book-hyperbook;
    in-out property <string> new-book-password;
    in-out property <string> new-member-name;
    in-out property <string> new-agreement-name;
    in-out property <int> new-agreement-how: 2;
    in-out property <string> new-agreement-day: "1";
    in-out property <int> new-agreement-weekday: 4;
    in-out property <string> new-agreement-start;
    in-out property <int> new-agreement-split: 0;
    in property <string> new-agreement-start-hint;
    in-out property <string> unlock-password;

    // ----- what the person does -----
    callback check-hub();
    callback pair();
    callback open-agreement(int);
    callback sync-now();
    callback add-expense();
    callback expense-changed();
    callback exp-need-edited(int, string);
    callback exp-item-add();
    callback exp-item-amount(int, string);
    callback exp-item-member(int, int);
    callback exp-item-remove(int);
    callback rule-amount(int, string);
    callback open-form(string);
    callback form-kind(int);
    callback form-sub-picked(int);
    callback form-person(int);
    callback form-person2(int);
    callback form-save();
    callback rule-remainder(int);
    callback payer-picked(int);
    callback save-expense();
    callback add-payment();
    callback pay-from-picked(int);
    callback pay-to-picked(int);
    callback save-payment();
    callback new-rule();
    callback rule-method-picked(int);
    callback rule-weight(int, float);
    callback rule-toggle(int);
    callback rule-lock(int);
    callback rule-changed();
    callback propose-rule();
    callback approve(int, bool);
    callback close-period(string);
    callback statement(string);
    callback delete-entry(int);
    callback edit-entry(int);
    callback dispute-entry(int);
    // pictures and PDFs on an expense
    callback attach-file(int);
    // undo a mistaken change to a deposit: (deposit row, record, its text)
    callback correct-deposit(int, int, string);
    callback open-file(string, string);
    callback detach-file(int, string, string);
    callback dismiss-refused();
    callback record-due(int);
    callback paid-due(int);
    callback stop-recurring(int);
    callback hub-set-pin();
    callback hub-new-book();
    callback hub-unlock(string);
    callback hub-close-book();
    in property <bool> ez-has-agreement;
    // EZ Start step 5's parts (5a–5f) and the phone's certificate steps
    in-out property <int> ez-sub;
    in-out property <int> ez-phone;
    in property <string> ez-apple-steps;
    in property <string> ez-android-steps;
    in property <string> hub-own-fingerprint;
    in property <string> hub-cert-page;
    callback hub-refresh();
    callback ez-pair-another();
    callback ez-back();
    callback ez-next();
    callback ez-finish();
    callback ez-open();
    callback hub-add-member();
    callback hub-member-picked(int);
    callback hub-new-agreement();
    callback hub-make-code(int);
    callback hub-remove-device(int);
    callback save-checkpoint();
    callback save-checkpoint-file();
    callback save-checkpoint-pdf();
    callback forget-checkpoint();
    callback hub-save-lost();
    callback check-checkpoint();
    callback check-statement();
    callback verify();
    callback accept-restore();
    callback export-csv(string);
    callback export-pdf(string);
    callback hub-recover(string);
    callback hub-recover-pick(string);
    callback hub-restore();
    callback hub-recover-cancel();
    callback hub-export-broken();

    VerticalLayout {
        // ----- header -----
        Rectangle {
            height: 56px;
            background: Theme.accent;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 8px;
                if root.page == 2: LinkButton { text: "‹ Back"; fg: white; clicked => { root.page = 1; } }
                Text {
                    text: root.page == 0 || root.page == 6 || root.page == 7 ? "EZ Start" : root.page == 2 ? root.agreement-name : root.book-name != "" ? root.book-name : "ShareKeep";
                    color: white;
                    font-size: 19px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.page != 0 && root.page != 6 && root.page != 7: LinkButton { text: root.busy ? "Syncing…" : "Sync"; fg: white; clicked => { root.sync-now(); } }
            }
        }

        // ----- pages -----
        Rectangle {
            vertical-stretch: 1;

            // 0: join a household hub — EZ Start, one step at a time
            if root.page == 0: Page {
                if root.join-step == 1: EzStep {
                    number: 1; total: 3;
                    title: "Find your household's hub";
                    purpose: "One computer in the household keeps the books (the hub). This device sends and receives everything through it, over your home Wi-Fi.";
                    Hint { text: "On the hub computer, open ShareKeep > Hub. Its address is at the top (like 192.168.1.20)."; }
                    Field { label: "Hub address"; placeholder: "192.168.1.20"; text <=> root.hub-address; }
                    BigButton { text: root.busy ? "Looking…" : "Find the hub"; enabled: !root.busy && root.hub-address != ""; clicked => { root.check-hub(); } }
                    if root.connect-error != "": Text { text: root.connect-error; color: Theme.red; wrap: word-wrap; }
                }
                if root.join-step == 1 && !root.is-hub: LinkButton { text: "‹ Back: join a hub, or make this computer the hub"; fg: Theme.muted; clicked => { root.page = 7; root.make-hub-step = 0; } }
                if root.join-step == 2: EzStep {
                    number: 2; total: 3;
                    title: "Check it's really your hub";
                    purpose: "The fingerprint proves this device is talking to your hub and not something pretending to be it. Everything you send is encrypted for that hub only.";
                    back => { root.join-step = 1; }
                    Hint { text: "Compare with the fingerprint on the hub computer's Hub tab:"; }
                    Text { text: root.hub-fingerprint; font-size: 18px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    BigButton { text: "They match"; clicked => { root.join-step = 3; } }
                    BigButton { text: "They don't match"; primary: false; danger: true; clicked => { root.join-step = 1; } }
                }
                if root.join-step == 3: EzStep {
                    number: 3; total: 3;
                    title: "Pair this device";
                    purpose: "The pairing code says who this device belongs to; the household PIN proves you're part of the household. You do this once.";
                    back => { root.join-step = 2; }
                    Hint { text: "On the hub computer: Hub > Pair a device > tap your name. It shows the code."; }
                    Field { label: "Pairing code"; placeholder: "ABCD-EFGH"; text <=> root.connect-code; }
                    Field { label: "Household PIN"; placeholder: "6 to 12 digits"; secret: true; text <=> root.connect-pin; }
                    Field { label: "Name this device"; placeholder: "Sam's laptop"; text <=> root.device-name; }
                    Field { label: "Checkpoint (optional)"; placeholder: "ShareKeep checkpoint · …"; text <=> root.connect-checkpoint; }
                    Hint { text: "If the household keeps a checkpoint of a Hyperbook, paste or type it: this device then checks that the hub's history still contains it before using the book."; }
                    BigButton { text: root.busy ? "Pairing…" : "Pair this device"; enabled: !root.busy && root.connect-code != "" && root.connect-pin != "" && root.device-name != ""; clicked => { root.pair(); } }
                    if root.connect-error != "": Text { text: root.connect-error; color: Theme.red; wrap: word-wrap; }
                }
            }

            // 7: the first question on a computer that isn't paired and isn't the hub (0.1.4)
            if root.page == 7 && root.make-hub-step == 0: Page {
                Text { text: "Welcome to ShareKeep"; font-size: 24px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                Hint { text: "One computer in the household keeps the books: the hub. Every other phone and computer joins it."; }
                Card {
                    SectionTitle { text: "Join my household's hub"; }
                    Text { text: "Someone in your household already set up ShareKeep on another computer. This one connects to it."; color: Theme.ink; wrap: word-wrap; }
                    BigButton { text: "Join my household's hub"; clicked => { root.join-step = 1; root.page = 0; } }
                }
                Card {
                    SectionTitle { text: "Make this computer the hub"; }
                    Text { text: "This computer keeps the household's books. It should stay on and on the home network. Choose this on one computer only."; color: Theme.ink; wrap: word-wrap; }
                    if root.hub-offer-kind != "no": BigButton { text: "Make this computer the hub"; primary: false; clicked => { root.make-hub-error = ""; root.make-hub-step = 1; } }
                    if root.hub-offer-kind == "no": Hint { text: root.hub-offer-note; }
                    if root.hub-folder-note != "": Text { text: root.hub-folder-note; color: Theme.amber; wrap: word-wrap; }
                }
            }
            if root.page == 7 && root.make-hub-step == 1: Page {
                Text { text: "Make this computer the hub"; font-size: 24px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                Card {
                    if root.hub-offer-kind == "windows": Text { text: "Windows will ask for administrator permission (the program is sharekeep-hub.exe). Then the hub runs in the background from now on, even when ShareKeep is closed."; color: Theme.ink; wrap: word-wrap; }
                    if root.hub-offer-kind == "mac": Text { text: "Terminal opens \"Install the household hub\" and asks for this Mac's password, only to start the hub in the background. Come back here when it says it's done."; color: Theme.ink; wrap: word-wrap; }
                    Hint { text: "First, give this computer a fixed address on your router (a DHCP reservation), so phones always find it."; }
                    if root.hub-offer-kind == "windows": BigButton { text: root.make-hub-busy ? "Waiting for Windows…" : "Continue"; enabled: !root.make-hub-busy; clicked => { root.make-hub(); } }
                    if root.hub-offer-kind == "mac" && !root.make-hub-busy: BigButton { text: "Open it in Terminal"; clicked => { root.make-hub(); } }
                    if root.hub-offer-kind == "mac" && root.make-hub-busy: Hint { text: "Waiting for the hub to start… ShareKeep goes on by itself once it's running."; }
                    if root.hub-offer-kind == "mac" && root.make-hub-busy: BigButton { text: "I've done it"; primary: false; clicked => { root.check-for-hub(); } }
                    if root.make-hub-error != "": Text { text: root.make-hub-error; color: Theme.red; wrap: word-wrap; }
                }
                if !root.make-hub-busy || root.hub-offer-kind == "mac": LinkButton { text: "‹ Back"; fg: Theme.muted; clicked => { root.make-hub-step = 0; root.make-hub-busy = false; } }
            }

            // 6: EZ Start on the hub computer, one step at a time
            if root.page == 6: Page {
                if root.hub-error != "": Banner { text: root.hub-error; warn: true; }
                if root.ez-step == 1: EzStep {
                    number: 1; total: 5;
                    title: "Choose the household PIN";
                    purpose: "Every phone and computer types it once, when it joins. It keeps neighbours on the same Wi-Fi out.";
                    if root.hub-pin-set: Text { text: "✓ The PIN is set. Change it here, or go on: devices already paired keep working."; color: Theme.ink; wrap: word-wrap; }
                    Field { label: root.hub-pin-set ? "New PIN (6 to 12 digits)" : "PIN (6 to 12 digits)"; secret: true; number: true; text <=> root.hub-pin; }
                    BigButton { text: root.hub-pin-set ? "Change the PIN" : "Save the PIN"; primary: !root.hub-pin-set; enabled: root.hub-pin.character-count >= 6 && root.hub-pin.character-count <= 12 && root.hub-pin.is-float(); clicked => { root.hub-set-pin(); } }
                    if root.hub-pin-set: BigButton { text: "Next: keep this PIN"; clicked => { root.ez-next(); } }
                }
                if root.ez-step == 2: EzStep {
                    number: 2; total: 5;
                    title: "Create the household's book";
                    purpose: "The book is where all of your household's shared money is recorded. It stays on this computer.";
                    back => { root.ez-back(); }
                    // a book is already open: keep it, or close it to create another
                    if root.hub-current-name != "": Text { text: "✓ Working in " + root.hub-current-name + "."; color: Theme.ink; wrap: word-wrap; }
                    if root.hub-current-name != "": Hint { text: root.hub-current-detail; }
                    if root.hub-current-name != "": BigButton { text: "Next: use " + root.hub-current-name; clicked => { root.ez-next(); } }
                    if root.hub-current-name != "": BigButton { text: "Close it, to create a different book"; primary: false; clicked => { root.hub-close-book(); } }
                    if root.hub-current-name == "": Field { label: "Book name"; placeholder: "Home"; text <=> root.new-book-name; }
                    if root.hub-current-name == "": Switch { text: "Make it a Hyperbook"; checked <=> root.new-book-hyperbook; }
                    if root.hub-current-name == "": Hint { text: "A Hyperbook keeps every change for good, chained so no one can quietly rewrite the past. You choose now; it can't be changed later."; }
                    if root.hub-current-name == "": Field { label: "Password (optional: encrypts the book)"; secret: true; text <=> root.new-book-password; }
                    if root.hub-current-name == "": BigButton { text: "Create the book"; enabled: root.new-book-name != ""; clicked => { root.hub-new-book(); } }
                    if root.hub-current-name == "" && root.hub-books.length > 0: Hint { text: "Or open one of this hub's other books on the Hub tab (Skip EZ Start below)."; }
                }
                if root.ez-step == 3: EzStep {
                    number: 3; total: 5;
                    title: "Add the people";
                    purpose: "Everyone who shares money in this household: you too. Each person gets their own balance and approves the rules.";
                    back => { root.ez-back(); }
                    for m in root.hub-agreement-members: Text { text: "✓ " + m.label; color: Theme.ink; }
                    Field { label: "Name"; placeholder: "Sam"; text <=> root.new-member-name; }
                    BigButton { text: "Add this person"; primary: false; enabled: root.new-member-name != ""; clicked => { root.hub-add-member(); } }
                    BigButton { text: root.ez-people >= 2 ? "That's everyone" : "Add at least two people"; enabled: root.ez-people >= 2; clicked => { root.ez-next(); } }
                }
                if root.ez-step == 4: EzStep {
                    number: 4; total: 5;
                    title: "Create your first agreement";
                    purpose: "An agreement is something you share and settle up together (the apartment, a car). It sets who's in, how often you settle up, and how expenses split.";
                    back => { root.ez-back(); }
                    Field { label: "Agreement name"; placeholder: "Apartment"; text <=> root.new-agreement-name; }
                    Hint { text: "Who shares in it:"; }
                    ChipStrip { chips: root.hub-agreement-members; picked(id) => { root.hub-member-picked(id); } }
                    AgreementOptions { how <=> root.new-agreement-how; day <=> root.new-agreement-day; weekday <=> root.new-agreement-weekday; start <=> root.new-agreement-start; split <=> root.new-agreement-split; start-hint: root.new-agreement-start-hint; }
                    BigButton { text: "Create the agreement"; enabled: root.new-agreement-name != "" && root.hub-pick-count > 0; clicked => { root.hub-new-agreement(); } }
                    if root.ez-has-agreement: BigButton { text: "Next: the agreements are made"; primary: false; clicked => { root.ez-next(); } }
                }
                // step 5 walks through the phone's side too, one part at a time (5a–5f), so the
                // person doing it reads here and acts on the phone
                if root.ez-step == 5: EzStep {
                    number: 5; total: 5;
                    title: "Pair the first device";
                    purpose: "Each person's phone or computer joins once. After that it syncs with this hub on its own whenever it's on the home Wi-Fi.";
                    can-back: root.ez-sub == 0;
                    back => { root.ez-back(); }
                    Text { text: "Step 5" + ["a", "b", "c", "d", "e", "f"][root.ez-sub] + " of 5f: " + ["Choose whose device", "Scan the code with the phone", "Install the certificate on the phone", "Open the household page", "Join from the phone", "Check that it joined"][root.ez-sub]; font-size: 17px; font-weight: 700; color: Theme.accent-dark; wrap: word-wrap; }
                    if root.ez-sub == 0: Hint { text: "Tap whose phone or computer it is. A pairing code and its QR code appear; they work once, for 10 minutes."; }
                    if root.ez-sub == 0: ChipStrip { chips: root.hub-members; picked(id) => { root.hub-make-code(id); } }
                    if root.ez-sub == 0 && (root.hub-code != ""): Text { text: "Pairing code " + root.hub-code; font-weight: 600; color: Theme.ink; }
                    if root.ez-sub == 0 && (root.hub-code != ""): Hint { text: "A computer instead of a phone? On it, open ShareKeep, follow Join (find the hub at this computer's address), and type this code and the PIN. Then go to 5f."; }
                    if root.ez-sub == 0: BigButton { text: "Next: scan it with the phone"; enabled: root.hub-code != ""; clicked => { root.ez-sub = 1; } }
                    if root.ez-sub == 1: Hint { text: "On the phone, open the Camera and point it at this code. Tap the link that appears. It opens the hub's certificate page in the phone's browser (on an iPhone, Safari)."; }
                    if root.ez-sub == 1: Image { source: root.hub-qr; width: 200px; height: 200px; image-rendering: pixelated; horizontal-alignment: center; }
                    if root.ez-sub == 1: Text { text: root.hub-code; font-size: 24px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; }
                    if root.ez-sub == 1: Hint { text: "The page is titled “ShareKeep household hub”. No camera link? Type " + root.hub-cert-page + " into the phone's browser."; }
                    if root.ez-sub == 1: BigButton { text: "Next: the page is open"; clicked => { root.ez-sub = 2; } }
                    if root.ez-sub == 2: Hint { text: "The certificate lets the phone open ShareKeep securely. Which phone is it?"; }
                    if root.ez-sub == 2: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip { text: "iPhone or iPad"; on: root.ez-phone == 0; clicked => { root.ez-phone = 0; } }
                        Chip { text: "Android"; on: root.ez-phone == 1; clicked => { root.ez-phone = 1; } }
                    }
                    // the numbered list as one wrapped text: Slint measures a repeated wrapped
                    // line too short, and the page then overlaps
                    if root.ez-sub == 2: Text { text: root.ez-phone == 0 ? root.ez-apple-steps : root.ez-android-steps; color: Theme.ink; wrap: word-wrap; }
                    if root.ez-sub == 2: Text { text: "The fingerprint here, to compare:"; color: Theme.muted; }
                    if root.ez-sub == 2: Text { text: root.hub-own-fingerprint; font-family: "monospace"; font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                    if root.ez-sub == 2: Hint { text: "If they don't match, stop: the phone isn't talking to this computer."; }
                    if root.ez-sub == 2: BigButton { text: "Next: the certificate is installed"; clicked => { root.ez-sub = 3; } }
                    if root.ez-sub == 3: Hint { text: "Go back to the browser on the phone, to the certificate page. Under “Step 2: join the household”, tap Open ShareKeep."; }
                    if root.ez-sub == 3: Hint { text: "The household page opens at “Step 2 of 3: Enter the household PIN”. (If the browser warns that the connection isn't private, the certificate isn't trusted yet: go back to 5c.)"; }
                    if root.ez-sub == 3: BigButton { text: "Next: the household page is open"; clicked => { root.ez-sub = 4; } }
                    if root.ez-sub == 4: Text { text: "1.  Type the household PIN (the one from step 1), then tap Next.\n\n2.  Name the device, like Sam's phone, so the household can tell devices apart.\n\n3.  Only if the household keeps a checkpoint of a Hyperbook: tap “I have a checkpoint” and paste or type it.\n\n4.  Tap Join the household. The household's agreements appear on the phone."; color: Theme.ink; wrap: word-wrap; }
                    if root.ez-sub == 4: Hint { text: "To keep ShareKeep on the phone's home screen: on an iPhone, Share > Add to Home Screen; on Android, the browser's menu > Install app."; }
                    if root.ez-sub == 4: BigButton { text: "Next: check it joined"; clicked => { root.ez-sub = 5; root.hub-refresh(); } }
                    if root.ez-sub == 5: Hint { text: "The device appears here once it has joined:"; }
                    for d in (root.ez-sub == 5 ? root.hub-devices : []): Text { text: (d.revoked ? "– " : "✓ ") + d.name + " · " + d.detail; color: d.revoked ? Theme.muted : Theme.ink; }
                    if root.ez-sub == 5 && (root.hub-devices.length == 0): Text { text: "No device has joined yet."; color: Theme.amber; }
                    if root.ez-sub == 5: LinkButton { text: "Check again"; clicked => { root.hub-refresh(); } }
                    if root.ez-sub == 5: BigButton { text: "Pair another device"; primary: false; clicked => { root.ez-pair-another(); } }
                    if root.ez-sub == 5: BigButton { text: "Finish"; clicked => { root.ez-finish(); } }
                    if root.ez-sub > 0: LinkButton { text: "‹ Back to step 5" + ["a", "b", "c", "d", "e", "f"][root.ez-sub - 1]; fg: Theme.muted; clicked => { root.ez-sub -= 1; } }
                }
                LinkButton { text: "Skip EZ Start: show everything on the Hub tab"; fg: Theme.muted; clicked => { root.ez-finish(); } }
            }

            // 1: home
            if root.page == 1: Page {
                if root.restore-text != "": Card {
                    stripe: Theme.amber-line;
                    SectionTitle { text: "A backup was restored"; }
                    Hint { text: root.restore-text; }
                    BigButton { text: "Accept and carry on"; clicked => { root.accept-restore(); } }
                }
                if root.banner != "": Banner { text: root.banner; warn: root.offline; }
                if root.pending > 0: Banner { text: root.pending + " waiting to send to the hub."; warn: true; }
                for c in root.cards: Card {
                    clickable: true;
                    stripe: c.sign > 0 ? Theme.green : c.sign < 0 ? Theme.red : Theme.line;
                    clicked => { root.open-agreement(c.id); }
                    HorizontalLayout {
                        SectionTitle { text: c.name; horizontal-stretch: 1; }
                        if c.waiting > 0: Badge { text: c.waiting + " to approve"; fg: Theme.amber; fill: Theme.amber-soft; }
                    }
                    Text { text: c.headline; font-size: 17px; font-weight: 700; color: c.sign > 0 ? Theme.green : c.sign < 0 ? Theme.red : Theme.ink; }
                    for m in c.members: HorizontalLayout {
                        Text { text: m.name; color: Theme.muted; horizontal-stretch: 1; }
                        Amount { text: m.balance; sign: m.sign; }
                    }
                    Hint { text: "This period: " + c.period; }
                }
                if root.cards.length == 0: Card {
                    SectionTitle { text: "Nothing to show yet"; }
                    Hint { text: "Your household's agreements appear here once the hub computer adds you to one."; }
                }
            }

            // 2: an agreement
            if root.page == 2: VerticalLayout {
                Rectangle {
                    height: 52px;
                    background: Theme.card;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;
                        Chip { text: "Activity"; on: root.tab == 0; clicked => { root.tab = 0; } }
                        Chip { text: "Members"; on: root.tab == 1; clicked => { root.tab = 1; } }
                        Chip { text: "Rules"; on: root.tab == 2; clicked => { root.tab = 2; } }
                        Chip { text: "Periods"; on: root.tab == 3; clicked => { root.tab = 3; } }
                    }
                }
                if root.tab == 0: Page {
                    HorizontalLayout {
                        spacing: 8px;
                        BigButton { text: "+ Expense"; clicked => { root.add-expense(); } }
                        BigButton { text: "Record payment"; primary: false; clicked => { root.add-payment(); } }
                    }
                    Hint { text: "This period: " + root.agreement-period; }
                    if root.due.length > 0: Card {
                        stripe: Theme.amber-line;
                        SectionTitle { text: "Due"; }
                        for d[i] in root.due: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: d.name + " · " + d.date + (d.overdue ? " (overdue)" : ""); color: Theme.ink; }
                                Hint { text: d.detail; }
                            }
                            if d.bill: LinkButton { text: "Record"; clicked => { root.record-due(i); } }
                            if !d.bill && d.mine: LinkButton { text: "I paid"; clicked => { root.paid-due(i); } }
                        }
                    }
                    for a in root.activity: Card {
                        stripe: a.disputed ? Theme.amber-line : transparent;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: a.title; font-weight: 600; color: Theme.ink; overflow: elide; }
                                Hint { text: a.date + " · " + a.detail + (a.disputed ? " · disputed" : ""); }
                            }
                            Text { text: a.amount; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                        }
                        if a.files.length > 0: HorizontalLayout {
                            alignment: start;
                            spacing: 2px;
                            for f in a.files: HorizontalLayout {
                                LinkButton { text: f.name + " (" + f.size + ")"; clicked => { root.open-file(f.sha, f.name); } }
                                LinkButton { text: "×"; fg: Theme.red; clicked => { root.detach-file(a.seq, f.sha, f.name); } }
                            }
                        }
                        // a closed period's expense can still take a receipt
                        if !a.editable && a.can-attach: HorizontalLayout {
                            alignment: end;
                            LinkButton { text: "+ Picture or PDF"; clicked => { root.attach-file(a.seq); } }
                        }
                        if a.editable: HorizontalLayout {
                            alignment: end;
                            if a.can-attach: LinkButton { text: "+ Picture or PDF"; clicked => { root.attach-file(a.seq); } }
                            if a.title != "Payment": LinkButton { text: "Edit"; clicked => { root.edit-entry(a.seq); } }
                            LinkButton { text: a.disputed ? "Resolve" : "Dispute"; fg: Theme.amber; clicked => { root.dispute-entry(a.seq); } }
                            LinkButton { text: "Delete"; fg: Theme.red; clicked => { root.delete-entry(a.seq); } }
                        }
                    }
                    if root.activity.length == 0: Hint { text: "No expenses yet. Add the first one with + Expense."; }
                }
                if root.tab == 1: Page {
                    Card {
                        SectionTitle { text: "Balances"; }
                        for m in root.members: HorizontalLayout {
                            Text { text: m.name; color: Theme.ink; horizontal-stretch: 1; }
                            Amount { text: m.balance; sign: m.sign; }
                        }
                        Hint { text: "Positive: the household owes them. Negative: they owe the household."; }
                    }
                    Card {
                        SectionTitle { text: "To settle up"; }
                        for s in root.settle: Text { text: s; color: Theme.ink; wrap: word-wrap; }
                        if root.settle.length == 0: Hint { text: "Everyone is settled up."; }
                    }
                    Card {
                        SectionTitle { text: "Deposits and pots"; }
                        for d[i] in root.deposits: VerticalLayout {
                            HorizontalLayout {
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text { text: d.label; color: Theme.ink; }
                                    Hint { text: d.kind + " · " + d.detail; }
                                }
                                Text { text: d.balance; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                            }
                            // its recent changes; a mistake is undone by a correction
                            for ev in d.history: HorizontalLayout {
                                Hint { text: ev.text; horizontal-stretch: 1; }
                                if ev.can-correct: LinkButton { text: "Undo"; fg: Theme.amber; clicked => { root.correct-deposit(i, ev.seq, ev.text); } }
                            }
                            HorizontalLayout {
                                alignment: end;
                                LinkButton { text: "Put money in"; clicked => { root.open-form("pay-in:" + i); } }
                                if d.kind == "Held": LinkButton { text: "Paid back / bought out"; clicked => { root.open-form("move:" + i); } }
                            }
                        }
                        if root.deposits.length == 0: Hint { text: "A security deposit, a utility deposit, or a pot the household pays bills from."; }
                        LinkButton { text: "+ Deposit or pot"; clicked => { root.open-form("deposit"); } }
                    }
                    Card {
                        SectionTitle { text: "Moving in and out"; }
                        HorizontalLayout {
                            spacing: 8px;
                            if root.can-join: BigButton { text: "Someone joins"; primary: false; clicked => { root.open-form("join"); } }
                            BigButton { text: "Someone leaves"; primary: false; clicked => { root.open-form("leave"); } }
                        }
                    }
                }
                if root.tab == 2: Page {
                    BigButton { text: "Propose a rule"; clicked => { root.new-rule(); } }
                    for r in root.rules: Card {
                        HorizontalLayout {
                            SectionTitle { text: r.name; horizontal-stretch: 1; }
                            Badge { text: r.method; }
                        }
                        Hint { text: r.detail; }
                    }
                    if root.rules.length == 0: Hint { text: "No rules yet. Propose one: it takes effect once everyone approves."; }
                    Card {
                        SectionTitle { text: "Recurring bills"; }
                        for r in root.recurring: HorizontalLayout {
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: r.name; color: r.stopped ? Theme.muted : Theme.ink; }
                                Hint { text: r.detail; }
                            }
                            if !r.stopped: LinkButton { text: "Stop"; fg: Theme.red; clicked => { root.stop-recurring(r.id); } }
                        }
                        if root.recurring.length == 0: Hint { text: "None yet. Each shows under Due when it's due, until someone records it with the real amount."; }
                        LinkButton { text: "+ Recurring bill"; clicked => { root.open-form("recurring"); } }
                    }
                }
                if root.tab == 3: Page {
                    Card {
                        SectionTitle { text: "Settling up"; }
                        Text { text: root.schedule-text; color: Theme.ink; wrap: word-wrap; }
                        LinkButton { text: "Change how often"; clicked => { root.open-form("schedule"); } }
                    }
                    Card {
                        SectionTitle { text: "Special events"; }
                        Hint { text: "A trip or a party settles on its own, apart from the everyday bills."; }
                        for e in root.events: VerticalLayout {
                            Text { text: e.name; color: Theme.ink; }
                            Hint { text: e.detail; }
                        }
                        LinkButton { text: "+ Special event"; clicked => { root.open-form("event"); } }
                    }
                    for p in root.periods: Card {
                        stripe: p.closed ? Theme.line : p.can-close ? Theme.amber-line : Theme.accent;
                        HorizontalLayout {
                            SectionTitle { text: p.label; horizontal-stretch: 1; }
                        }
                        Hint { text: p.state; }
                        if p.can-close: BigButton { text: "Close this period"; clicked => { root.close-period(p.key); } }
                        if p.closed: BigButton { text: "Save the statement (PDF)"; primary: false; clicked => { root.statement(p.key); } }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            LinkButton { text: "Export to a spreadsheet (CSV)"; clicked => { root.export-csv(p.key); } }
                            LinkButton { text: "Export as PDF"; clicked => { root.export-pdf(p.key); } }
                        }
                    }
                }
            }

            // 3: approvals
            if root.page == 3: Page {
                SectionTitle { text: "Waiting for you"; }
                for a in root.approvals: Card {
                    stripe: Theme.amber-line;
                    Text { text: a.title; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    Hint { text: a.detail; }
                    HorizontalLayout {
                        spacing: 8px;
                        BigButton { text: "Approve"; clicked => { root.approve(a.seq, true); } }
                        BigButton { text: "Decline"; primary: false; danger: true; clicked => { root.approve(a.seq, false); } }
                    }
                }
                if root.approvals.length == 0: Hint { text: "Nothing waits for your approval."; }
            }

            // 4: settings
            if root.page == 4: Page {
                Card {
                    SectionTitle { text: "This device"; }
                    KeyValue { label: "You are"; value: root.me-name; }
                    KeyValue { label: "Book"; value: root.book-name; }
                    KeyValue { label: "Waiting to send"; value: root.pending; }
                    BigButton { text: "Sync now"; primary: false; clicked => { root.sync-now(); } }
                }
                if root.refused.length > 0: Card {
                    stripe: Theme.red;
                    SectionTitle { text: "Not accepted by the hub"; }
                    for r in root.refused: Text { text: r; wrap: word-wrap; color: Theme.ink; }
                    LinkButton { text: "Dismiss"; clicked => { root.dismiss-refused(); } }
                }
                if root.restore-text != "": Card {
                    stripe: Theme.amber-line;
                    SectionTitle { text: "A backup was restored"; }
                    Hint { text: root.restore-text; }
                    BigButton { text: "Accept and carry on"; clicked => { root.accept-restore(); } }
                }
                if root.checkpoint-failed: Card {
                    stripe: Theme.red;
                    SectionTitle { text: "Your checkpoint isn't in the hub's history"; }
                    Hint { text: root.banner; }
                    Hint { text: "If it was typed wrong, or the household restored a backup and agreed to it, forget it and this device uses the hub's history as it is."; }
                    BigButton { text: "Forget the checkpoint"; primary: false; danger: true; clicked => { root.forget-checkpoint(); } }
                }
                if root.is-hyperbook: Card {
                    SectionTitle { text: "Hyperbook"; }
                    KeyValue { label: "History"; value: root.hb-head; }
                    Hint { text: root.hb-fingerprint; }
                    if root.hb-seen != "": Hint { text: root.hb-seen; }
                    if root.hb-stale != "": Hint { text: root.hb-stale; color: Theme.amber; }
                    BigButton { text: "Save a checkpoint"; primary: false; clicked => { root.save-checkpoint(); } }
                    if root.checkpoint-text != "": VerticalLayout {
                        spacing: 8px;
                        Hint { text: "Keep this outside the house: print it, photograph the QR code, or email it to yourself. Check a checkpoint shows later whether the history still contains it, unchanged."; }
                        LineEdit { text: root.checkpoint-text; read-only: true; min-height: 40px; }
                        Image { source: root.checkpoint-qr; width: 180px; height: 180px; image-rendering: pixelated; horizontal-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            BigButton { text: "Save as PDF (to print)"; primary: false; clicked => { root.save-checkpoint-pdf(); } }
                            BigButton { text: "Save as text"; primary: false; clicked => { root.save-checkpoint-file(); } }
                        }
                    }
                    Field { label: "Check a checkpoint: paste or type it"; placeholder: "ShareKeep checkpoint · …"; text <=> root.checkpoint-input; }
                    BigButton { text: "Check it"; primary: false; enabled: root.checkpoint-input != ""; clicked => { root.check-checkpoint(); } }
                    BigButton { text: "Check a statement (PDF)"; primary: false; clicked => { root.check-statement(); } }
                    if root.check-answer != "": Banner { text: root.check-answer; warn: !root.check-ok; }
                }
                Card {
                    SectionTitle { text: "Verify"; }
                    Hint { text: root.is-hyperbook ? "Two questions, answered from the whole history on this device: has it been changed, and do the numbers add up?" : "Do the numbers add up? Every record is replayed under the book's rules, on this device."; }
                    BigButton { text: "Verify the book"; primary: false; clicked => { root.verify(); } }
                    if root.verify-answer != "": Banner { text: root.verify-answer; warn: !root.verify-ok; }
                }
                Card {
                    SectionTitle { text: "Help and questions"; }
                    Hint { text: "The same answers are on the hub's help page, which a phone opens from its Settings."; }
                    Text { text: root.help-text; color: Theme.ink; wrap: word-wrap; }
                }
                Card {
                    SectionTitle { text: "About"; }
                    Hint { text: "ShareKeep, part of the MoneyKeep family. MIT OR Apache-2.0. The third-party licences are in THIRD-PARTY-LICENSES.txt, beside the program."; }
                    // the Slint Royalty-free License 2.0 asks for this (NOTICE)
                    AboutSlint { height: 120px; }
                }
            }

            // 5: the hub computer. It works in one book at a time: close it to open or create
            // another.
            if root.page == 5: Page {
                if root.hub-error != "": Banner { text: root.hub-error; warn: true; }
                LinkButton { text: "EZ Start: set up step by step"; clicked => { root.ez-open(); } }
                if root.hub-info != "": Banner { text: root.hub-info; }
                Card {
                    stripe: root.hub-current-name != "" ? Theme.accent : Theme.line;
                    SectionTitle { text: root.hub-current-name != "" ? "Working in: " + root.hub-current-name : "No book is open"; }
                    if root.hub-current-name != "": Hint { text: root.hub-current-detail; }
                    if root.hub-current-name != "": BigButton { text: "Close this book"; primary: false; clicked => { root.hub-close-book(); } }
                    if root.hub-current-name == "": Hint { text: "Open a book below, or create a new one. The hub serves one book at a time; devices of a closed book wait until it's open again."; }
                }
                Card {
                    SectionTitle { text: "Pair a device"; }
                    if root.hub-current-name == "": Hint { text: "Open a book first."; }
                    if root.hub-current-name != "" && !root.hub-pin-set: Hint { text: "Set the household PIN first (below)."; }
                    if root.hub-current-name != "" && root.hub-pin-set: Hint { text: "Pick who the device belongs to. A phone scans the QR code: it opens the certificate page, then the household. On a computer, type the address, the code and the PIN into the ShareKeep app. The code works once, for 10 minutes."; }
                    if root.hub-current-name != "" && root.hub-pin-set: ChipStrip { chips: root.hub-members; picked(id) => { root.hub-make-code(id); } }
                    if root.hub-code != "": VerticalLayout {
                        spacing: 8px;
                        alignment: center;
                        Image { source: root.hub-qr; width: 200px; height: 200px; image-rendering: pixelated; horizontal-alignment: center; }
                        Text { text: root.hub-code; font-size: 28px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; }
                        Hint { text: root.hub-code-detail; horizontal-alignment: center; }
                    }
                }
                Card {
                    SectionTitle { text: "Household PIN"; }
                    Hint { text: root.hub-pin-set ? "Set. Every device needs it once, when it pairs. You can change it; paired devices keep working." : "Every device needs it once, when it pairs. 6 to 12 digits."; }
                    Field { label: root.hub-pin-set ? "New PIN" : "PIN"; secret: true; number: true; text <=> root.hub-pin; }
                    BigButton { text: root.hub-pin-set ? "Change the PIN" : "Set the PIN"; primary: false; enabled: root.hub-pin.character-count >= 6 && root.hub-pin.character-count <= 12 && root.hub-pin.is-float(); clicked => { root.hub-set-pin(); } }
                }
                if root.hub-current-name != "": Card {
                    SectionTitle { text: "People and agreements in " + root.hub-current-name; }
                    Field { label: "Add a person"; placeholder: "Sam"; text <=> root.new-member-name; }
                    BigButton { text: "Add"; primary: false; enabled: root.new-member-name != ""; clicked => { root.hub-add-member(); } }
                    Field { label: "New agreement"; placeholder: "Apartment"; text <=> root.new-agreement-name; }
                    if root.hub-agreement-members.length == 0: Hint { text: "Add people first."; }
                    if root.hub-agreement-members.length > 0: Hint { text: "Who shares in it:"; }
                    ChipStrip { chips: root.hub-agreement-members; picked(id) => { root.hub-member-picked(id); } }
                    if root.hub-agreement-members.length > 0: AgreementOptions { how <=> root.new-agreement-how; day <=> root.new-agreement-day; weekday <=> root.new-agreement-weekday; start <=> root.new-agreement-start; split <=> root.new-agreement-split; start-hint: root.new-agreement-start-hint; }
                    BigButton { text: "Create the agreement"; primary: false; enabled: root.new-agreement-name != "" && root.hub-pick-count > 0; clicked => { root.hub-new-agreement(); } }
                }
                if root.rec-file != "": Card {
                    stripe: Theme.red;
                    SectionTitle { text: "Recover " + root.rec-name; }
                    Hint { text: root.rec-problem; }
                    Hint { text: "Pick a backup to carry on from. The broken book is kept, renamed, and its history can be saved as it is. Devices are told and accept the restore themselves."; }
                    for b in root.rec-backups: VerticalLayout {
                        spacing: 4px;
                        Text { text: b.title; font-weight: 600; color: b.ok ? Theme.ink : Theme.muted; }
                        Hint { text: b.detail; }
                        if b.ok: BigButton { text: "Use this backup"; primary: false; clicked => { root.hub-recover-pick(b.file); } }
                    }
                    if root.rec-backups.length == 0: Hint { text: "There are no backups of this book on the hub."; }
                    if root.rec-lost != "": Banner { text: root.rec-lost; warn: true; }
                    if root.rec-lost != "": LinkButton { text: "Save this list (to enter them again)"; clicked => { root.hub-save-lost(); } }
                    if root.rec-backup != "": BigButton { text: "Restore it"; danger: true; clicked => { root.hub-restore(); } }
                    BigButton { text: "Save the broken history as it is"; primary: false; clicked => { root.hub-export-broken(); } }
                    LinkButton { text: "Cancel"; clicked => { root.hub-recover-cancel(); } }
                }
                if root.hub-books.length > 0: Card {
                    SectionTitle { text: "Other books on this hub"; }
                    if root.hub-current-name != "": Hint { text: "Close " + root.hub-current-name + " to open one of these."; }
                    for b in root.hub-books: VerticalLayout {
                        spacing: 4px;
                        Text { text: b.name; font-weight: 600; color: Theme.ink; }
                        Hint { text: b.detail; }
                        if b.encrypted && root.hub-current-name == "": Field { label: "Password or recovery key"; secret: true; text <=> root.unlock-password; }
                        if !b.broken: BigButton { text: "Open " + b.name; primary: false; enabled: root.hub-current-name == "" && (!b.encrypted || root.unlock-password != ""); clicked => { root.hub-unlock(b.file); } }
                        if b.broken: BigButton { text: "Recover " + b.name; danger: true; enabled: root.hub-current-name == "" && (!b.encrypted || root.unlock-password != ""); clicked => { root.hub-recover(b.file); } }
                    }
                }
                Card {
                    SectionTitle { text: "New book"; }
                    if root.hub-current-name != "": Hint { text: "Close " + root.hub-current-name + " first, then create the new book."; }
                    if root.hub-current-name == "": Field { label: "Name"; placeholder: "Home"; text <=> root.new-book-name; }
                    if root.hub-current-name == "": Switch { text: "Make it a Hyperbook"; checked <=> root.new-book-hyperbook; }
                    if root.hub-current-name == "": Hint { text: "A Hyperbook keeps every change for good, chained so no one can quietly rewrite the past. It's chosen now and can't be changed later."; }
                    if root.hub-current-name == "": Field { label: "Password (optional: encrypts the book)"; secret: true; text <=> root.new-book-password; }
                    BigButton { text: "Create the book"; primary: false; enabled: root.hub-current-name == "" && root.new-book-name != ""; clicked => { root.hub-new-book(); } }
                }
                Card {
                    SectionTitle { text: "Devices"; }
                    for d in root.hub-devices: HorizontalLayout {
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: d.name; color: d.revoked ? Theme.muted : Theme.ink; }
                            Hint { text: d.detail; }
                        }
                        if !d.revoked: LinkButton { text: "Remove"; fg: Theme.red; clicked => { root.hub-remove-device(d.id); } }
                    }
                    if root.hub-devices.length == 0: Hint { text: "No devices paired yet."; }
                }
            }
        }

        // ----- bottom tabs -----
        // EZ Start shows only its step: no tabs
        if root.page != 0 && root.page != 6 && root.page != 7: Rectangle {
            height: 60px;
            background: Theme.card;
            drop-shadow-blur: 8px;
            drop-shadow-color: #0f172a1a;
            HorizontalLayout {
                NavTab { icon: "⌂"; label: "Home"; active: root.page == 1 || root.page == 2; clicked => { root.page = 1; } }
                NavTab { icon: "✓"; label: "Approvals"; active: root.page == 3; badge: root.approvals.length; clicked => { root.page = 3; } }
                if root.is-hub: NavTab { icon: "⌘"; label: "Hub"; active: root.page == 5 || root.page == 6; clicked => { root.page = 5; } }
                NavTab { icon: "⚙"; label: "Settings"; active: root.page == 4; badge: root.refused.length; clicked => { root.page = 4; } }
            }
        }
    }

    // ----- the expense sheet -----
    if root.exp-open: Sheet {
        title: root.exp-title;
        dismissed => { root.exp-open = false; }
        Field { label: "Amount"; placeholder: "0.00"; number: true; text <=> root.exp-amount; edited => { root.expense-changed(); } }
        Field { label: "Category"; placeholder: "Groceries"; text <=> root.exp-category; edited => { root.expense-changed(); } }
        Field { label: "Date (YYYY-MM-DD)"; text <=> root.exp-date; edited => { root.expense-changed(); } }
        Field { label: "Note (optional)"; text <=> root.exp-note; }
        FieldLabel { text: "Paid by"; }
        ChipStrip { chips: root.exp-payers; picked(id) => { root.payer-picked(id); } }
        if root.exp-itemized: Card {
            SectionTitle { text: root.exp-needs-title; }
            for it[i] in root.exp-items: VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Field { label: "Line " + (i + 1); placeholder: "0.00"; number: true; text: it.amount; edited(t) => { root.exp-item-amount(i, t); } }
                    LinkButton { text: "Remove"; fg: Theme.red; clicked => { root.exp-item-remove(i); } }
                }
                ChipStrip { chips: it.members; picked(id) => { root.exp-item-member(i, id); } }
            }
            LinkButton { text: "+ Line"; clicked => { root.exp-item-add(); } }
        }
        if root.exp-needs.length > 0: Card {
            SectionTitle { text: root.exp-needs-title; }
            for n[i] in root.exp-needs: Field {
                label: n.name;
                number: true;
                text: n.value;
                edited(t) => { root.exp-need-edited(i, t); }
            }
        }
        Card {
            SectionTitle { text: "How it divides"; }
            SplitList { rows: root.exp-preview; }
            if root.exp-no-rule != "": Text { text: root.exp-no-rule; color: Theme.amber; wrap: word-wrap; }
            if root.exp-no-rule != "": BigButton { text: "Propose how it's split"; primary: false; clicked => { root.propose-for-expense(); } }
            if root.exp-error != "" && root.exp-no-rule == "": Text { text: root.exp-error; color: Theme.red; wrap: word-wrap; }
        }
        BigButton { text: "Save"; enabled: root.exp-error == "" && root.exp-preview.length > 0; clicked => { root.save-expense(); } }
    }

    // ----- the payment sheet -----
    if root.pay-open: Sheet {
        title: "Record a payment";
        dismissed => { root.pay-open = false; }
        Field { label: "Amount"; placeholder: "0.00"; number: true; text <=> root.pay-amount; }
        FieldLabel { text: "From"; }
        ChipStrip { chips: root.pay-from; picked(id) => { root.pay-from-picked(id); } }
        FieldLabel { text: "To"; }
        ChipStrip { chips: root.pay-to; picked(id) => { root.pay-to-picked(id); } }
        if root.pay-error != "": Text { text: root.pay-error; color: Theme.red; wrap: word-wrap; }
        BigButton { text: "Save"; clicked => { root.save-payment(); } }
    }

    // ----- the form sheet -----
    if root.form-open: Sheet {
        title: root.form-title;
        dismissed => { root.form-open = false; }
        if root.form-kinds-label != "": FieldLabel { text: root.form-kinds-label; }
        if root.form-kinds-label != "": ChipStrip { chips: root.form-kinds; picked(id) => { root.form-kind(id); } }
        if root.form-name-label != "": Field { label: root.form-name-label; placeholder: root.form-name-placeholder; text <=> root.form-name; }
        if root.form-amount-label != "": Field { label: root.form-amount-label; placeholder: "0.00"; number: true; text <=> root.form-amount; }
        if root.form-sub-label != "": FieldLabel { text: root.form-sub-label; }
        if root.form-sub-label != "": ChipStrip { chips: root.form-sub; picked(id) => { root.form-sub-picked(id); } }
        if root.form-text-label != "": Field { label: root.form-text-label; placeholder: root.form-text-placeholder; text <=> root.form-text; }
        if root.form-date-label != "": Field { label: root.form-date-label; placeholder: "YYYY-MM-DD"; text <=> root.form-date; }
        if root.form-date2-label != "": Field { label: root.form-date2-label; placeholder: "YYYY-MM-DD"; text <=> root.form-date2; }
        if root.form-people-label != "": FieldLabel { text: root.form-people-label; }
        if root.form-people-label != "": ChipStrip { chips: root.form-people; picked(id) => { root.form-person(id); } }
        if root.form-people2-label != "": FieldLabel { text: root.form-people2-label; }
        if root.form-people2-label != "": ChipStrip { chips: root.form-people2; picked(id) => { root.form-person2(id); } }
        if root.form-hint != "": Hint { text: root.form-hint; }
        if root.form-error != "": Text { text: root.form-error; color: Theme.red; wrap: word-wrap; }
        BigButton { text: root.form-save-text; clicked => { root.form-save(); } }
    }

    // ----- the rule editor -----
    if root.rule-open: Sheet {
        title: "Propose a rule";
        dismissed => { root.rule-open = false; }
        Field { label: "Name"; placeholder: "Rent 2027"; text <=> root.rule-name; edited => { root.rule-changed(); } }
        Field { label: "Categories it's the default for (comma-separated)"; placeholder: "Rent, Utilities"; text <=> root.rule-categories; }
        FieldLabel { text: "Method"; }
        ChipStrip { chips: root.rule-methods; picked(id) => { root.rule-method-picked(id); } }
        Card {
            SectionTitle { text: root.rule-percent ? "Percentages (always total 100%)" : "Who shares"; }
            if root.rule-hint != "": Hint { text: root.rule-hint; }
            for w[i] in root.rule-weights: VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Switch { text: w.name; checked: w.included; toggled => { root.rule-toggle(i); } }
                    Text {
                        text: !w.included ? "opted out" : root.rule-percent ? round(w.value) + "%" : root.rule-weighted ? round(w.value) + root.rule-unit : "";
                        color: Theme.ink;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.rule-percent && w.included: LinkButton { text: w.locked ? "Locked" : "Lock"; fg: w.locked ? Theme.amber : Theme.accent; clicked => { root.rule-lock(i); } }
                    if root.rule-exact && w.included: LinkButton { text: w.remainder ? "Takes what's left" : "Give them what's left"; fg: w.remainder ? Theme.green : Theme.accent; clicked => { root.rule-remainder(i); } }
                }
                if root.rule-exact && w.included && !w.remainder: Field { label: "Fixed amount"; placeholder: "0.00"; number: true; text: w.amount; edited(t) => { root.rule-amount(i, t); } }
                if w.included && root.rule-weighted: Slider {
                    minimum: 0;
                    maximum: root.rule-max;
                    value: w.value;
                    enabled: !w.locked;
                    changed(v) => { root.rule-weight(i, v); }
                }
            }
        }
        Card {
            SectionTitle { text: "Examples"; }
            if root.rule-error != "": Text { text: root.rule-error; color: Theme.red; wrap: word-wrap; }
            for e in root.rule-examples: VerticalLayout {
                spacing: 4px;
                Text { text: e.amount; font-weight: 700; color: Theme.ink; }
                SplitList { rows: e.rows; }
            }
        }
        Hint { text: root.rule-when; }
        BigButton { text: "Propose"; enabled: root.rule-error == "" && root.rule-name != ""; clicked => { root.propose-rule(); } }
    }

    // ----- a passing message -----
    if root.toast != "": Rectangle {
        y: parent.height - 120px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, 480px);
        height: tt.preferred-height + 20px;
        border-radius: 10px;
        background: #1e293bee;
        tt := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.toast;
            color: white;
            wrap: word-wrap;
        }
    }
}
